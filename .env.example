# Leave these unset to run on the local JSON file at .data/db.json.
# Set both to switch the whole app over to Supabase Postgres.
#
# Run supabase/schema.sql in the SQL editor first.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The anon key is enough with the demo policies in schema.sql.
# Prefer the service-role key if you tighten those policies — it is read here
# on the server only, so it never reaches the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
